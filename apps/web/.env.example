# apps/web — browser + Next.js server config. Copy to `apps/web/.env` (gitignored).
# No AI/provider secrets here, ever.

NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js (NextAuth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=dev-only-change-me-min-32-chars-please
AUTH_URL=http://localhost:3000

# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID,
# type "Web application", redirect URI http://localhost:3000/api/auth/callback/google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared with apps/api to sign the short-lived API JWT (ADR-005). Must match apps/api/.env.
AUTH_JWT_SECRET=dev-only-change-me-min-16-chars
