# apps/web — browser + Next.js server config. Copy to `apps/web/.env` (gitignored).
# No AI/provider secrets here, ever.

NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js (Google) — created in Phase 4.
AUTH_SECRET=dev-only-change-me
# Shared with apps/api to sign the short-lived API JWT (ADR-005).
AUTH_JWT_SECRET=dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
