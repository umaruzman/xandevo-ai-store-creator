# apps/api — server-only configuration. Copy to `apps/api/.env` (gitignored).
# These values never reach the browser.

NODE_ENV=development
API_PORT=4000

# Database — matches docker-compose.yml (`pnpm db:up`). Read by Prisma and Nest.
DATABASE_URL=postgresql://xandevo:xandevo@localhost:5433/xandevo?schema=public

# AI provider (ADR-004). Anthropic is the only provider implemented; keep this
# as-is and set ANTHROPIC_API_KEY (https://console.anthropic.com -> API Keys).
# (AI_PROVIDER=fake returns a fixed sample store with no API call — CI/offline only.)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Persist every AI request/response to the `ai_interactions` table for
# cost/debug inspection. Off by default — the rows hold full prompt text.
AI_LOG_INTERACTIONS=false
# OPENAI_API_KEY / GEMINI_API_KEY — not implemented yet.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shared secret the web app signs the short-lived API JWT with (ADR-005). Used from Phase 4.
AUTH_JWT_SECRET=dev-only-change-me
