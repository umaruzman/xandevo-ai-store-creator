# apps/api — server-only configuration. Copy to `apps/api/.env` (gitignored).
# These values never reach the browser.

NODE_ENV=development
API_PORT=4000

# Database — matches docker-compose.yml (`pnpm db:up`). Read by Prisma and Nest.
DATABASE_URL=postgresql://xandevo:xandevo@localhost:5433/xandevo?schema=public

# AI provider (ADR-004 — default anthropic, no fallback in MVP). Used from Phase 5.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shared secret the web app signs the short-lived API JWT with (ADR-005). Used from Phase 4.
AUTH_JWT_SECRET=dev-only-change-me
