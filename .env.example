# ─────────────────────────────────────────────────────────────────────────────
# Xandevo environment. Copy to `.env` and fill in. Never commit `.env`.
# Server-only values live in apps/api; the browser only sees NEXT_PUBLIC_* vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── apps/api : database ─────────────────────────────────────────────────────
# Matches docker-compose.yml (see `pnpm db:up`).
DATABASE_URL=postgresql://xandevo:xandevo@localhost:5432/xandevo?schema=public

# ── apps/api : AI provider (ADR-004 — default anthropic, no fallback in MVP) ─
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed if AI_PROVIDER is switched:
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── apps/api : auth (ADR-005) ──────────────────────────────────────────────
# Shared secret the web app signs the short-lived API JWT with; the API verifies it.
AUTH_JWT_SECRET=dev-only-change-me
API_PORT=4000

# ── apps/web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Auth.js (Google) — created in Phase 4.
AUTH_SECRET=dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
